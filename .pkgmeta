package-as: JustQuest

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
    - .git
    - .github
    - .gitignore
    - .luarc.json
    - .pkgmeta
    - README.md
    - CHANGELOG.md
    - UNRELEASED.md
    - Documentation
    - Debug
    - tools
    - AGENTS.md
    - CONTRIBUTING.md
    - build.ps1
    - release.ps1
    - "*.code-workspace"
